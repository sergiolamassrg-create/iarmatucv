{
  "name": "iarmatucv-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",

    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1162.0",
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@google/genai": "^2.32.0",
    "aws-jwt-verify": "^5.2.1",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
